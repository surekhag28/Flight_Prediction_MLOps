FROM apache/airflow:2.8.2-python3.11

USER root

# ── System deps + Java 17 ──────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
        openjdk-17-jre-headless \
        wget \
        curl \
        procps \
        libgomp1 \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Dynamic JAVA_HOME detection (works for amd64 and arm64)
RUN JAVA_HOME=$(dirname $(dirname $(readlink -f $(which java)))) && \
    echo "export JAVA_HOME=${JAVA_HOME}" >> /etc/environment && \
    echo "JAVA_HOME=${JAVA_HOME}" >> /etc/profile.d/java.sh

# ── Spark 3.4.1 ───────────────────────────────────────────────────────────────
ENV SPARK_VERSION=3.4.1
ENV SPARK_HOME=/opt/spark
ENV PATH="${SPARK_HOME}/bin:${PATH}"

RUN wget -q "https://archive.apache.org/dist/spark/spark-${SPARK_VERSION}/spark-${SPARK_VERSION}-bin-hadoop3.tgz" \
    && tar -xzf "spark-${SPARK_VERSION}-bin-hadoop3.tgz" -C /opt \
    && mv "/opt/spark-${SPARK_VERSION}-bin-hadoop3" "${SPARK_HOME}" \
    && rm "spark-${SPARK_VERSION}-bin-hadoop3.tgz"

# ── Hadoop-AWS + AWS SDK JARs (for S3A/MinIO) ─────────────────────────────────
RUN wget -q -P "${SPARK_HOME}/jars" \
        "https://repo1.maven.org/maven2/org/apache/hadoop/hadoop-aws/3.3.4/hadoop-aws-3.3.4.jar" \
        "https://repo1.maven.org/maven2/com/amazonaws/aws-java-sdk-bundle/1.12.262/aws-java-sdk-bundle-1.12.262.jar"

# ── Python path for PySpark ───────────────────────────────────────────────────
ENV PYTHONPATH="/opt/airflow:/opt/spark/python:/opt/spark/python/lib/py4j-0.10.9.7-src.zip:/opt/src:${PYTHONPATH}"
ENV PYSPARK_PYTHON=python3
ENV PYSPARK_DRIVER_PYTHON=python3

# Copy project source
COPY --chown=airflow:root . /opt/src
COPY --chown=airflow:root airflow/dags /opt/airflow/dags
COPY --chown=airflow:root feature_repo /opt/feature_repo
COPY --chown=airflow:root pyproject.toml /opt/src/pyproject.toml

USER airflow

# ── Python dependencies ───────────────────────────────────────────────────────
# Install uv for fast dependency resolution, then install with pip
RUN pip install --no-cache-dir --upgrade pip uv

# Install all needed dependency groups
RUN pip install --no-cache-dir \
    pyspark==3.4.1 \
    "pandas>=2.1" \
    "numpy>=1.26" \
    "pyarrow>=16,<=17" \
    "boto3>=1.34" \
    "s3fs>=2024.2" \
    "pydantic>=2.5" \
    "pydantic-settings>=2.0" \
    "pyyaml>=6.0" \
    "requests>=2.31" \
    "lightgbm>=4.3" \
    "scikit-learn>=1.4" \
    "mlflow==2.22.4" \
    #"protobuf>=5.26,<7" \
    "protobuf>=4.25,<5" \
    "email-validator>=2.0" \
    "evidently>=0.4" \
    "optuna>=3.6" \
    "joblib>=1.3" \
    "feast[redis]>=0.36" \
    "fastapi>=0.109" \
    "uvicorn>=0.27" \
    "prometheus-client>=0.19" \
    "great-expectations>=1.0" \
    "xgboost>=2.0" \
    "catboost>=1.2" \
    "shap>=0.44"

WORKDIR /opt/airflow